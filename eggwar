-- newgod.vip/eggwar - the eggwars farm.
--
-- This is the team farm: it splits the shells between the bots, and the leader
-- fights while they do it. Put your own accounts into the roster table inside
-- EGGWARS_FARM.lua before you run it on more than one client.
--
-- One account still runs, but only the leader half of it: the shell splitting is
-- what the other three are for.

local URL = "https://newgod.vip/skywars/EGGWARS_FARM.lua"

local function pull(u)
    local ok, body = pcall(function() return game:HttpGet(u) end)
    if ok and type(body) == "string" and #body > 2000 then return body end
    return nil
end

local body
for _ = 1, 6 do
    body = pull(URL)
    if body then break end
    task.wait(2)
end
if not body then
    error("newgod eggwar: could not reach " .. URL)
end

local fn, err = loadstring(body, "=EGGWARS_FARM")
if not fn then
    error("newgod eggwar: could not compile EGGWARS_FARM.lua : " .. tostring(err))
end
return fn()
