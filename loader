local ROUTES = {
    [84556640895285] = "https://newgod.vip/deagle",
    [112087763192016] = "https://newgod.vip/deagle",
    [94334870778766] = "https://newgod.vip/deagle",
    [8542259458] = "https://newgod.vip/skywars/loader",
    [8542275097] = "https://newgod.vip/skywars/loader",
    [8951451142] = "https://newgod.vip/skywars/loader",
}
local FALLBACK = "https://newgod.vip/tpfarm.lua"

local function pull(url)
    local ok, body = pcall(function()
        return game:HttpGet(url)
    end)
    if ok and type(body) == "string" and #body > 200 then
        return body
    end
    return nil
end

local url = ROUTES[game.PlaceId] or FALLBACK
local body = pull(url)
if not body and url ~= FALLBACK then
    body = pull(FALLBACK)
end
if not body then
    error("newgod loader could not reach " .. url)
end

local fn, err = loadstring(body)
if not fn then
    error("newgod loader could not compile " .. url .. " : " .. tostring(err))
end
return fn()
